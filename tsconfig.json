{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "types": ["node"],
    "lib": ["ES2023","DOM","DOM.Iterable"]
  },
  "include": ["src/**/*.ts","tests/**/*.ts"]
}
