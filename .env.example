PORT=8787
SITEPROOF_API_KEY=change-me
SITEPROOF_MCP_URL=http://localhost:8787/mcp
PUBLIC_BASE_URL=http://localhost:8787
MAX_PAGES=150
EXPORT_TTL_MINUTES=30
FIX_PREVIEW_TTL_MINUTES=30
USER_AGENT=SiteProofBot/0.4

# Optional: enables write-capable GitHub Fix Mode.
# Use a fine-grained token or GitHub App token with access only to repositories SiteProof is allowed to fix.
SITEPROOF_GITHUB_TOKEN=

# Recommended production guardrail. Comma-separated owner/repo entries.
# Example: jmqbataller/SiteProof,jmqbataller/client-site
SITEPROOF_GITHUB_ALLOWED_REPOS=

# Workflow-file edits are blocked by default because they can change CI/CD behavior.
SITEPROOF_ALLOW_WORKFLOW_EDITS=false
