PORT=8787
SITEPROOF_API_KEY=change-me
MAX_PAGES=150
MAX_LINKS=750
CRAWL_CONCURRENCY=3
LINK_CONCURRENCY=10
REQUEST_TIMEOUT_MS=20000
USER_AGENT=SiteProofBot/0.2 (+https://github.com/jmqbataller/SiteProof)
DATA_DIR=./data

# Browser / full-force mode
BROWSER_ENABLED=true
HEADLESS=true
SCREENSHOT_MODE=findings
PERFORMANCE_PAGES=1
VISUAL_SAMPLE_PAGES=5

# Safety: keep false in production. Useful only for localhost development/tests.
ALLOW_PRIVATE_TARGETS=false

# Optional Google CrUX API (Core Web Vitals field data)
GOOGLE_API_KEY=

# Optional Supabase persistence. If omitted, SiteProof uses local JSON storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
